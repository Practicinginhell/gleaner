# Environment variables gleaner reads: names only, NEVER values.
# Keep real values in a file outside the repo (e.g. ~/.config/gleaner/env) and export
# them before running. Tests need none of these.

# Llama via an OpenAI-compatible endpoint (graphflow's OpenAIModel)
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama, or your hosted Llama API's URL
# OPENAI_API_KEY=<from your provider>          # not needed for local Ollama
# OLLAMA_MODEL=Qwen/Qwen3.5-0.8B:latest        # Global model override (e.g. Qwen/Qwen3.5-0.8B:latest or llama3.2:3b)
# GLEANER_MODEL=...                           # Alternative global model override
# LLAMA_JUDGE_MODEL=llama3.2:3b               # Role-specific overrides
# LLAMA_WRITER_MODEL=llama3.1:8b
# LLAMA_ASK_MODEL=llama3.1:8b
